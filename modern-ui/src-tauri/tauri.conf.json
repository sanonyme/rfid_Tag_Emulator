{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeus RFID Emulator",
  "version": "9.1.1",
  "identifier": "com.edge.rfid-emulator",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:tauri-web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zeus RFID Emulator",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "category": "Development",
    "shortDescription": "RFID tag emulation for Edge testing",
    "longDescription": "Zeus RFID Emulator simulates fixed readers, handhelds, and OCR devices over TCP for Edge server testing.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ],
        "files": {}
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzNzMyQUIxMjc0RjJGQkQKUldTOUwwOG5zU3B6NHlnNStQTVBveTdJTlErdGZxNjF0U0tnbTlKUFBDQ3NMNkdRcTVxMTN1MUMK",
      "endpoints": [
        "https://github.com/sanonyme/zeus-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
