# Optional: used only with `npm run workshop:staging` from your Windows PC when
# Postgres on CT 251 is reachable (SSH tunnel or LAN bind). Never put production CT 250 here.
#
# Example SSH tunnel from Proxmox host:
#   ssh -L 15432:192.168.10.251:5432 root@192.168.10.200
# Then (password from CT 251 /etc/zeus-workshop.env):
#   DATABASE_URL=postgresql://workshop:PASSWORD@127.0.0.1:15432/workshop
DATABASE_URL=
