# Bare public hostname, without https:// or a path.
WORKSHOP_DOMAIN=workshop.example.com
# Generate a long random hexadecimal password; do not reuse an account password.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=

# Required for creating verified accounts. Server only; never put in the desktop app.
BREVO_API_KEY=
WORKSHOP_EMAIL_FROM=
