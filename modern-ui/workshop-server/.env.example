# Copy to workshop-server/.env on the server only. Never send database credentials to players.
HOST=127.0.0.1
PORT=8787
# For local testing, leave DATABASE_URL empty to use persistent embedded Postgres.
DATABASE_URL=
# Production requires a Postgres connection string and NODE_ENV=production.
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE
# Bind localhost when an HTTPS reverse proxy runs on the same machine.
WORKSHOP_ORIGINS=null,file://,http://localhost:5173,http://127.0.0.1:5173

# Server-only Brevo transactional mail (free plan); never copy into desktop .env.
BREVO_API_KEY=
WORKSHOP_EMAIL_FROM=
