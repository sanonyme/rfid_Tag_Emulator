# Copy to .env and fill in your values. Never commit .env to git.

# App release publishing (electron-builder -> GitHub Releases)
# Keep your source repository private and publish installers to a separate public repo.
# Create a public repo (for example: rfid_Tag_Emulator_Releases) and set:
# ZEUS_RELEASE_OWNER=<github-owner>
# ZEUS_RELEASE_REPO=<public-releases-repo-name>
# For publishing to both repos with `npm run release:both`, also set:
# ZEUS_SECOND_RELEASE_OWNER=<github-owner-for-second-repo>
# ZEUS_SECOND_RELEASE_REPO=<second-repo-name>
# Authentication token (required for publish) should be provided as GH_TOKEN
# (recommended in CI secret; optional in local .env only for local release runs).
# ZEUS_RELEASE_OWNER=
# ZEUS_RELEASE_REPO=
# ZEUS_SECOND_RELEASE_OWNER=
# ZEUS_SECOND_RELEASE_REPO=
# GH_TOKEN=

# Install registry (Supabase Edge Function, etc.)
# - Release / production: put INSTALL_REGISTRY_URL (and optional REGISTRY_TOKEN) in this file
#   before `npm run release` or `vite build` — they are embedded in the desktop app so end users
#   do not need a .env beside the installed .exe.
# - Per-machine override: place .env next to the installed .exe (same folder); it wins at startup.

# Supabase: Edge Function URL (see supabase/README.md), e.g.:
# INSTALL_REGISTRY_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/register-install
INSTALL_REGISTRY_URL=

# Optional: same value as Supabase Edge Function secret REGISTRY_TOKEN (Authorization: Bearer ...).
# REGISTRY_TOKEN=

# ---------------------------------------------------------------------------
# Renderer-side (browser) variables. Must start with `VITE_` to be exposed.
# ---------------------------------------------------------------------------

# ALE credentials (optional, for ALE integration)
# VITE_ALE_USERNAME=
# VITE_ALE_PASSWORD=
