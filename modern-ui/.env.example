# Copy to .env and fill in your values. Never commit .env to git.

# Optional: for packaged app, you can also place .env next to the .exe (loaded at startup).

# Supabase: Edge Function URL (see supabase/README.md), e.g.:
# INSTALL_REGISTRY_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/register-install
INSTALL_REGISTRY_URL=

# Optional: same value as Supabase Edge Function secret REGISTRY_TOKEN (Authorization: Bearer ...).
# REGISTRY_TOKEN=

# ---------------------------------------------------------------------------
# Renderer-side (browser) variables. Must start with `VITE_` to be exposed.
# ---------------------------------------------------------------------------

# ALE credentials (optional, for ALE integration)
# VITE_ALE_USERNAME=
# VITE_ALE_PASSWORD=
