      "steps": [
        {
          "id": "d-note",
          "type": "COMMENT",
          "name": "Needs a host",
          "position": {
            "x": 40,
            "y": 40
          },
          "params": {
            "commentText": "These nodes talk to real devices. Connect a host/reader first, or just open each to see how it is configured."
          }
