        {
          "id": "d-fixed",
          "type": "FIXED_TAG",
          "name": "Fixed reader — 5 tags",
          "position": {
            "x": 40,
            "y": 230
          },
          "params": {
            "upcList": "0361100300001, 3\n0361100300002, 2",
            "startSerial": 1,
            "antenna": "1,2",
            "rssi": "-52.0",
            "rssiRandomize": false,
            "driver": "llrp"
