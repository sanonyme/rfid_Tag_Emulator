{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "electron",
    "src/lib/tcp-wire-format.ts",
    "src/lib/handheld-wire-format.ts",
    "src/lib/sftp-remote-path.ts",
    "src/lib/log-aggregator.ts"
  ]
}
