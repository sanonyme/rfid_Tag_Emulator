{
  "name": "rfid-emulator-modern",
  "version": "4.2.2",
  "description": "Zeus RFID Tag Emulator UI",
  "author": {
    "name": "Anexya",
    "email": "samichemaly30@gmail.com"
  },
  "homepage": "https://github.com/sanonyme/rfid_Tag_Emulator",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --win --linux",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env OPEN_DEVTOOLS=true electron .\"",
    "electron:clean": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "release": "vite build && dotenv -e .env -- electron-builder --publish always"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.263.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.edge.rfid-emulator",
    "productName": "Zeus RFID Emulator",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/node_modules/**/test/**/*",
      "!**/node_modules/**/doc/**/*",
      "!**/node_modules/**/example/**/*",
      "!**/node_modules/**/demo/**/*"
    ],
    "compression": "maximum",
    "asar": true,
    "extraResources": [
      {
        "from": "public/zeus-removebg-preview.png",
        "to": "logo.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signingHashAlgorithms": [
        "sha256"
      ],
      "sign": null,
      "icon": "resources/icon-256.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Zeus RFID Emulator",
      "runAfterFinish": true,
      "artifactName": "${productName} Setup ${version}.exe"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Development",
      "icon": "resources/app-icon-1024.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/app-icon-1024.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sanonyme",
        "repo": "rfid_Tag_Emulator"
      }
    ]
  }
}
